# Copy to .env (loaded automatically by app/config.py). All have safe dev defaults.

# --- Security ---
JWT_SECRET=dev-insecure-change-me
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=480
PHI_HMAC_KEY=dev-phi-hmac-key-change-me   # stands in for Azure Key Vault secret

# --- LLM (OpenAI / Azure OpenAI). Leave blank to use the deterministic stub. ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small
# For Azure OpenAI instead of openai.com, also set:
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Vector search. Use memory locally; pinecone for portfolio deployment. ---
VECTOR_STORE=memory
PINECONE_API_KEY=
PINECONE_INDEX_NAME=financial-rag-demo
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_DIMENSION=1536

# --- Alerting (optional). Leave blank to keep alerts DB-only. ---
SLACK_WEBHOOK_URL=

# --- Data generation ---
SYNTH_MONTHS=20          # months of synthetic history to generate
SYNTH_SEED=42
